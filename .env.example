# ExpatAutoAdviser — environment variables
#
# This file lists EVERY variable the code actually reads, and nothing else.
# Derived from `grep -r process.env api/ src/` on 2026-08-06. Placeholder
# values only — never commit a real key here.
#
# Production values live in the Vercel project `expatautoadviser`
# (Settings → Environment Variables), bound to Preview + Production.
# Copy this file to `.env.local` for local development.

# Brevo master API key. Read by api/subscribe.js.
# Without it: POST /api/subscribe returns HTTP 500 with code CONFIG_ERROR and
# the signup form shows an error. No contact is stored and no magnet is sent.
BREVO_API_KEY=

# Numeric ID of the Brevo "EAA pending" contact list. Read by api/subscribe.js.
# Without it: identical failure to a missing API key — 500 / CONFIG_ERROR,
# because there is no list to add the subscriber to.
BREVO_EAA_PENDING_LIST_ID=

# ── Not required ──────────────────────────────────────────────────────────
# GA4 is hard-coded in index.html (G-361S2D3P8X), not injected via env.
# BREVO_EAA_SG_LIST_ID and BREVO_EAA_HK_LIST_ID exist in the Vercel project
# but are referenced nowhere in this codebase (plumbing audit 2026-08-06,
# finding A4). Do not add them here until something reads them.
